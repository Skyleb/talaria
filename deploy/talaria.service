[Unit]
Description=Talaria chat server
Documentation=https://github.com/Skyleb/talaria
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=talaria
Group=talaria
WorkingDirectory=/opt/talaria
ExecStart=/opt/talaria/talaria -config /opt/talaria/talaria.toml
Restart=always
RestartSec=3
# Ports 80/443 (HTTPS + ACME) and 53 (optional LAN DNS) are privileged.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# install.sh substitutes the data dir (database + uploads), which may live on
# a separate big disk.
ReadWritePaths=/opt/talaria -@DATA_DIR@
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
